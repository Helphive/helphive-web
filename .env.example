VITE_API_URL=https://api.helphive.himaiz.com
# For local backend development, use this in .env.local:
# VITE_API_URL=http://localhost:8080
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# reCAPTCHA Enterprise site key (public) for client attestation; leave empty to skip it
VITE_RECAPTCHA_SITE_KEY=

# Production builds run on Cloudflare Workers Builds (every push to main); the production values are build
# variables on the helphive-web Worker (Settings > Builds), not files in the repo.

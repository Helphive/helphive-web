# Cloudflare Workers static assets headers (served by the helphive-web Worker; see wrangler.jsonc).
# The sha256 in script-src is the colour-scheme script inline in index.html: change it whenever that script changes.
# CSP sources: the API, Google Maps/Places and reCAPTCHA, Stripe, OneSignal web push, CometChat chat, Google Fonts,
# GCS profile images, OpenStreetMap tiles and Leaflet marker icons (cdnjs).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-sz6RpJWjKqa3jkRSbTZacSvdg0vXLDduoVdU+GCkH8o=' https://static.cloudflareinsights.com https://maps.googleapis.com https://*.gstatic.com https://www.google.com https://js.stripe.com https://*.js.stripe.com https://cdn.onesignal.com https://*.onesignal.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.onesignal.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://cloudflareinsights.com https://api.helphive.himaiz.com wss://api.helphive.himaiz.com https://*.googleapis.com https://www.google.com https://*.gstatic.com https://api.stripe.com https://*.stripe.com https://*.stripe.network https://onesignal.com https://*.onesignal.com https://*.cometchat.io wss://*.cometchat.io https://storage.googleapis.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://*.stripe.network https://www.google.com https://recaptcha.google.com https://*.onesignal.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' https: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(self "https://js.stripe.com")

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/OneSignalSDKWorker.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8
